    {
      "parameters": {
        "jsCode": "const body = $input.first().json;\n\n// يدعم أكثر من شكل محتمل لرد Message a model / Gemini\nconst raw =\n  body?.content?.[0]?.text ??\n  body?.content?.parts?.[0]?.text ??\n  body?.candidates?.[0]?.content?.parts?.[0]?.text ??\n  body?.text ??\n  '';\n\nconst cleaned = String(raw)\n  .replace(/```json/gi, '')\n  .replace(/```/g, '')\n  .trim();\n\nlet parsed;\n\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (error) {\n  parsed = {\n    summary: cleaned,\n    tasks: []\n  };\n}\n\nconst formData = $('On form submission').first().json;\n\nreturn [\n  {\n    json: {\n      summary: parsed.summary || '',\n      tasks: Array.isArray(parsed.tasks) ? parsed.tasks : [],\n      meetingTitle: formData['عنوان الاجتماع'],\n      email: formData['البريد لإرسال الملخص']\n    }\n  }\n];"
      },
